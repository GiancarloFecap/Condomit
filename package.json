{
  "name": "condomit",
  "version": "0.71.5",
  "private": true,
  "description": "Plataforma Condomit para web, desktop (Windows, macOS e Linux), Android e iOS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:project": "node tools/check-project.mjs",
    "mobile:build": "node mobile/build-web.mjs",
    "mobile:configure-native": "node mobile/configure-native.mjs",
    "mobile:sync": "npm run mobile:build && npx cap sync && npm run mobile:configure-native",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:run:android": "npm run mobile:sync && npx cap run android",
    "mobile:run:ios": "npm run mobile:sync && npx cap run ios",
    "mobile:doctor": "npx cap doctor",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --dir --config desktop/electron-builder.yml --publish never",
    "desktop:dist": "electron-builder --config desktop/electron-builder.yml --publish never",
    "desktop:dist:win": "electron-builder --config desktop/electron-builder.yml --win --publish never",
    "desktop:dist:mac": "electron-builder --config desktop/electron-builder.yml --mac --publish never",
    "desktop:dist:linux": "electron-builder --config desktop/electron-builder.yml --linux --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@getbrevo/brevo": "^6.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "nodemailer": "^9.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "Condomit",
    "email": "noreply@condomit.app"
  },
  "desktopName": "Condomit",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiancarloFecap/Condomit.git"
  }
}
